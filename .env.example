# 以下四项仅服务端使用，禁止添加 VITE_ 前缀。
# 复制为 .env.local，在需要连接数据库时填写。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 至少 12 字符；站长独用，与普通用户账号独立。
ADMIN_PASSWORD=
# 至少 32 随机字符，用于签名会话、匿名标识和限流标识。
ADMIN_SESSION_SECRET=

# 可选的公开配置，供其他 Supabase 项目或本地测试使用。
# 只允许 sb_publishable_ 公钥，服务端密钥不得填写在这里。
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# 可选的预约邮件配置，仅在服务商安全设置中填写。
# REMINDER_CRON_SECRET=
# REMINDER_SMTP_USER=
# REMINDER_SMTP_PASSWORD=
